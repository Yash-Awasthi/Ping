<?xml version="1.0" encoding="utf-8"?>
<!-- A ping: a solid origin dot sending two signal arcs to the upper right, with a cyan spark
     where the signal lands. Drawn inside the 66dp adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Soft glow behind the origin. -->
    <path
        android:fillColor="#3322E5FF"
        android:pathData="M28,66 a16,16 0 1,1 32,0 a16,16 0 1,1 -32,0 Z" />
    <!-- Outer arc. -->
    <path
        android:strokeColor="#B3FFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M44,34 A32,32 0 0,1 76,66" />
    <!-- Inner arc. -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"
        android:pathData="M44,48 A18,18 0 0,1 62,66" />
    <!-- Origin dot. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,66 a8,8 0 1,1 16,0 a8,8 0 1,1 -16,0 Z" />
    <!-- Spark: a four-point star where the signal lands. -->
    <path
        android:fillColor="#FF22E5FF"
        android:pathData="M74,26 Q75.2,32.8 82,34 Q75.2,35.2 74,42 Q72.8,35.2 66,34 Q72.8,32.8 74,26 Z" />
</vector>
